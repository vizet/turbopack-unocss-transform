{
  "name": "turbopack-unocss-transform",
  "version": "2.0.1",
  "license": "MIT",
  "author": "vizet <v@kogita.net>",
  "description": "UnoCSS transformers for Next.js: variant groups, attributify JSX and compile class with Turbopack and webpack.",
  "homepage": "https://github.com/vizet/turbopack-unocss-transform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vizet/turbopack-unocss-transform.git"
  },
  "keywords": [
    "nextjs",
    "turbopack",
    "webpack",
    "unocss",
    "postcss",
    "loader",
    "transform",
    "transformer",
    "transformers",
    "variant-group",
    "compile-class",
    "attributify",
    "attributify-jsx"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./postcss": {
      "import": "./dist/postcss.mjs",
      "require": "./dist/postcss.cjs"
    },
    "./loader": "./dist/loader.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "quality": "biome check --write .",
    "prepack": "tsdown"
  },
  "peerDependencies": {
    "@unocss/postcss": ">=66.5.0",
    "next": ">=16.0.0"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.158.0",
    "tinyglobby": "^0.2.17",
    "unplugin-utils": "^0.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^22.20.5",
    "@unocss/core": "66.12.0",
    "postcss": "^8.5.32",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  }
}
