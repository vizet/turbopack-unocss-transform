{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedDeclarations": false,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tsdown.config.ts"]
}
